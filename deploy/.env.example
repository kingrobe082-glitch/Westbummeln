# /opt/westbummeln/.env – einzige Stelle mit Geheimnissen. Rechte: 600, Besitzer deploy.
# Erzeugen mit ./env-init.sh (setzt SECRET_KEY und POSTGRES_PASSWORD zufällig), danach DOMAIN,
# ACME_EMAIL und DEVELOPER_* prüfen. Nie ins Repo legen.
#
# Compose liest diese Datei zweimal: für die ${…}-Platzhalter in docker-compose.prod.yml und als
# env_file für den Container web. ${VAR} verweist auf einen Wert weiter oben in dieser Datei.

# Welche Compose-Datei "docker compose …" in diesem Ordner benutzt.
COMPOSE_FILE=docker-compose.prod.yml

# --- Adresse
# Domain des Spiels; ihr A-Record zeigt auf die öffentliche IP des Servers.
# Notlösung ohne funktionierende Domain: <IP-mit-Bindestrichen>.sslip.io (RUNBOOK.md, Abschnitt 5).
DOMAIN=planspiel.7z2.de
# Für Ablauf-Warnungen von Let's Encrypt/ZeroSSL.
ACME_EMAIL=admin@example.com
# Folgen DOMAIN (hier also planspiel.7z2.de bzw. https://planspiel.7z2.de). Mehrere Namen mit Komma.
ALLOWED_HOSTS=${DOMAIN}
CSRF_TRUSTED_ORIGINS=https://${DOMAIN}

# --- Django
SECRET_KEY=wird-von-env-init-ersetzt
DEBUG=0

# --- Datenbank (Container db). Passwort nur aus [A-Za-z0-9], weil es in der URL steht.
POSTGRES_PASSWORD=wird-von-env-init-ersetzt
DATABASE_URL=postgresql://westbummeln:${POSTGRES_PASSWORD}@db:5432/westbummeln

# --- Entwicklerkonto (wird beim Start angelegt, falls es fehlt; Passwort 16–128 Zeichen)
DEVELOPER_USERNAME=
DEVELOPER_PASSWORD=

# --- Google-Anmeldung (optional, siehe KONTEN.md)
GOOGLE_CLIENT_ID=

# --- Discord (optional, siehe DISCORD.md)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_REDIRECT_URI=
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ROOM=
DISCORD_VOICE_URL=

# --- Backups: gehören diesem Benutzer (id -u deploy / id -g deploy)
BACKUP_UID=1000
BACKUP_GID=1000

# IMAGE_TAG setzt remote-deploy.sh nach jedem erfolgreichen Deploy selbst (Zeile unten).
