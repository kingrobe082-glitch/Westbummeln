{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListeNurImOrdnerWestbummeln",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::DEIN-BUCKET-NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["westbummeln/", "westbummeln/*"]
        }
      }
    },
    {
      "Sid": "NurHochladenKeinLesenKeinLoeschen",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::DEIN-BUCKET-NAME/westbummeln/*"
    }
  ]
}
